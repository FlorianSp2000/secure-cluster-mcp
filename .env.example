# Cluster connection (REQUIRED)
CLUSTER_HOST=your.cluster.ip
CLUSTER_USER=your_username
CLUSTER_PATH=/path/to/remote/project/

# SSH key (optional, default: ~/.ssh/id_rsa)
SSH_KEY_PATH=~/.ssh/id_rsa

# SAFETY: Keep true until ready for real execution!
DRY_RUN=true

# Guardrail limits (optional, these are defaults)
RATE_LIMIT_COMMANDS=30
RATE_LIMIT_WINDOW_SECONDS=300
MAX_CONCURRENT_JOBS=5
LOG_TAIL_LINES=100
