# Cluster connection (REQUIRED)
CLUSTER_HOST=your.cluster.ip
CLUSTER_USER=your_username
CLUSTER_PATH=/path/to/remote/project/
SSH_KEY_PATH=~/.ssh/id_rsa

# Safety mode (default: true)
# Set to false only after testing with DRY_RUN=true
DRY_RUN=true

# Log directory relative to CLUSTER_PATH (default: logs)
# Change if your cluster uses different log location
LOG_DIR=logs

# Optional: Guardrail limits (defaults shown)
# RATE_LIMIT_COMMANDS=30
# RATE_LIMIT_WINDOW_SECONDS=300
# LOG_TAIL_LINES=200
